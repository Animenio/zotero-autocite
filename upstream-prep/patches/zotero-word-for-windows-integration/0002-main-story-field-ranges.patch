+	// Word field coordinates, absolute in the main text story.
+	getMainStoryFieldRanges: function() {
+		checkIfFreed(this._documentStatus);
+		var values = new ctypes.long.ptr();
+		var count = new ctypes.unsigned_long();
+		checkStatus(f.getMainStoryFieldRanges(this._document_t,
+			values.address(), count.address()));
+		try {
+			var n = parseInt(count.value);
+			if (!Number.isSafeInteger(n) || n < 0 || n > 100000) {
+				throw new Error("Unsafe Word field count");
+			}
+			if (!n) return [];
+			if (values.isNull()) throw new Error("Word field list is absent");
+			var data = ctypes.cast(values, ctypes.long.array(n * 2).ptr).contents;
+			var ranges = [];
+			for (var i = 0; i < n; i++) {
+				ranges.push({
+					start: parseInt(data[2 * i]), end: parseInt(data[2 * i + 1])
+				});
+			}
+			return ranges;
+		}
+		finally {
+			if (!values.isNull()) f.freeData(values);
+		}
+	},
