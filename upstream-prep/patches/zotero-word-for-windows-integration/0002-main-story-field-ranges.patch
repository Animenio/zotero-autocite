+// Read-only boundaries of all fields in the main Word story.
+// Output pairs are absolute Word [start,end) offsets, free using freeData().
+statusCode __stdcall getMainStoryFieldRanges(document_t *doc,
+		long **returnPairs, unsigned long *returnCount) {
+	HANDLE_EXCEPTIONS_BEGIN
+	if (!doc || !returnPairs || !returnCount) {
+		DIE(L"Invalid main-story field range arguments");
+	}
+	*returnPairs = NULL;
+	*returnCount = 0;
+	CRange story = doc->comDoc.get_StoryRanges().Item(1);
+	const long low = story.get_Start();
+	const long high = story.get_End();
+	CFields fields = story.get_Fields();
+	const long count = fields.get_Count();
+	if (count < 0 || count > 100000) {
+		DIE(L"Unsafe Word field count");
+	}
+	std::vector<long> pairs;
+	pairs.reserve(static_cast<size_t>(count) * 2);
+	for (long i = 1; i <= count; i++) {
+		CField field = fields.Item(i);
+		CRange code = field.get_Code();
+		CRange result = field.get_Result();
+		long start = code.get_Start() - 1;
+		long end = result.get_End() + 1;
+		if (start < low || end > high || end <= start) {
+			DIE(L"Unsupported Word field boundary");
+		}
+		pairs.push_back(start);
+		pairs.push_back(end);
+	}
+	if (!pairs.empty()) {
+		long *output = static_cast<long*>(malloc(pairs.size() * sizeof(long)));
+		if (!output) {
+			DIE(L"Cannot allocate Word field boundaries");
+		}
+		for (size_t i = 0; i < pairs.size(); i++) {
+			output[i] = pairs[i];
+		}
+		*returnPairs = output;
+	}
+	*returnCount = static_cast<unsigned long>(count);
+	return STATUS_OK;
+	HANDLE_EXCEPTIONS_END
+}
