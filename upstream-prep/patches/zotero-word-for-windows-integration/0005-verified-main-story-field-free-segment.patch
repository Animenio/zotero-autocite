+// Read a field-free Word range only when its UTF-16 offsets are reliable.
+// This entry point does not modify the Word document content.
+statusCode __stdcall getVerifiedMainStorySegment(document_t *doc,
+        long start, long end, wchar_t **returnText) {
+	HANDLE_EXCEPTIONS_BEGIN
+	if (!doc || !returnText) {
+		DIE(L"Invalid verified segment arguments");
+	}
+	*returnText = NULL;
+	CStoryRanges stories = doc->comDoc.get_StoryRanges();
+	CRange story = stories.Item(1);
+	const long low = story.get_Start();
+	const long high = story.get_End();
+	if (start < low || end > high || end <= start ||
+		end - start > 16000000L) {
+		DIE(L"Unsafe Word segment coordinates");
+	}
+	CFields fields = story.get_Fields();
+	const long count = fields.get_Count();
+	if (count < 0 || count > 100000) {
+		DIE(L"Unsafe Word field count");
+	}
+	for (long i = 1; i <= count; i++) {
+		CField field = fields.Item(i);
+		CRange code = field.get_Code();
+		CRange result = field.get_Result();
+		const long protectedStart = code.get_Start() - 1;
+		const long protectedEnd = result.get_End() + 1;
+		if (protectedStart < low || protectedEnd > high ||
+			protectedEnd <= protectedStart) {
+			DIE(L"Unsafe protected Word field boundaries");
+		}
+		if (start < protectedEnd && end > protectedStart) {
+			DIE(L"Requested segment overlaps a Word field");
+		}
+	}
+	CRange segment = story.get_Duplicate();
+	segment.put_Start(start);
+	segment.put_End(end);
+	if (segment.get_Start() != start || segment.get_End() != end) {
+		DIE(L"Word changed segment boundaries");
+	}
+	CString contents = segment.get_Text();
+	if (contents.GetLength() != end - start ||
+		wcslen(contents.GetString()) != static_cast<size_t>(contents.GetLength())) {
+		DIE(L"Unreliable UTF-16 Word segment coordinates");
+	}
+	wchar_t *copy = _wcsdup(contents);
+	if (!copy) {
+		DIE(L"Could not allocate verified segment");
+	}
+	*returnText = copy;
+	return STATUS_OK;
+	HANDLE_EXCEPTIONS_END
+}
