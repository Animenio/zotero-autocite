+	/**
+	 * Return the main-story text and absolute Word offsets without modifying it.
+	 * offsetsReliable is false if Word's story length differs from UTF-16 text
+	 * length; callers must refuse all edits in that case.
+	 */
+	getMainStorySnapshot: function() {
+		checkIfFreed(this._documentStatus);
+		var returnText = new ctypes.jschar.ptr();
+		var returnStart = new ctypes.long();
+		var returnEnd = new ctypes.long();
+		checkStatus(f.getMainStorySnapshot(this._document_t,
+			returnText.address(), returnStart.address(), returnEnd.address()));
+		try {
+			var contents = returnText.readString();
+			var start = parseInt(returnStart.value);
+			var end = parseInt(returnEnd.value);
+			return {
+				text: contents,
+				storyStart: start,
+				storyEnd: end,
+				storyType: 'main',
+				offsetsReliable: contents.length === end - start
+			};
+		}
+		finally {
+			if (!returnText.isNull()) {
+				f.freeData(returnText);
+			}
+		}
+	},
