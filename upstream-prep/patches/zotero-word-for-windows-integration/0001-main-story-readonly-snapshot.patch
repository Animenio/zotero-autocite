+// Read-only native snapshot of Word's main text story.
+// The returned string is allocated with _wcsdup and must be freed using freeData().
+// Word field codes can make Range.Text length differ from Range.End - Range.Start;
+// the JS caller reports that mismatch and must not use unreliable offsets to edit.
+statusCode __stdcall getMainStorySnapshot(document_t *doc, wchar_t **returnText,
+		long *returnStart, long *returnEnd) {
+	HANDLE_EXCEPTIONS_BEGIN
+	if (!doc || !returnText || !returnStart || !returnEnd) {
+		DIE(L"Invalid main-story snapshot arguments");
+	}
+	*returnText = NULL;
+	CStoryRanges stories = doc->comDoc.get_StoryRanges();
+	CRange mainStory = stories.Item(1); // wdMainTextStory (1)
+	const long start = mainStory.get_Start();
+	const long end = mainStory.get_End();
+	if (start < 0 || end < start) {
+		DIE(L"Invalid Word main-story coordinates");
+	}
+	CString contents = mainStory.get_Text();
+	wchar_t *copy = _wcsdup(contents);
+	if (!copy) {
+		DIE(L"Could not allocate main-story snapshot");
+	}
+	*returnText = copy;
+	*returnStart = start;
+	*returnEnd = end;
+	return STATUS_OK;
+	HANDLE_EXCEPTIONS_END
+}
