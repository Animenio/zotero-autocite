+	// Read a field-free Word range only after native offset validation.
+	// Does not authorize Word modifications or bypass whole-document preflight.
+	getVerifiedMainStorySegment: function(start, end) {
+		checkIfFreed(this._documentStatus);
+		if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) ||
+			start < 0 || end <= start || end > 2147483647 || end - start > 16000000) {
+			throw new Error("Unsafe Word segment coordinates");
+		}
+		var value = new ctypes.jschar.ptr();
+		checkStatus(f.getVerifiedMainStorySegment(this._document_t,
+			ctypes.long(start), ctypes.long(end), value.address()));
+		try {
+			if (value.isNull()) throw new Error("Verified Word segment is absent");
+			var text = value.readString();
+			if (text.length !== end - start) {
+				throw new Error("Word segment coordinate length mismatch");
+			}
+			return {text: text, start: start, end: end, offsetsReliable: true};
+		}
+		finally {
+			if (!value.isNull()) f.freeData(value);
+		}
+	},
